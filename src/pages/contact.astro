---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact On The Go Ceylon | Plan Your Sri Lanka Tour"
  description="Plan your Sri Lanka journey with On The Go Ceylon. Contact us for custom itineraries, private chauffeur tours, airport transfers, and helpful travel support."
>
  <!-- Page Header -->
  <section
    class="relative pt-32 pb-20 bg-gray-100 dark:bg-brand-black border-b border-gray-200 dark:border-white/10 transition-colors duration-200"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span
        class="inline-block text-brand-gold text-xs font-bold tracking-widest uppercase mb-3"
      >
        Let’s Plan Your Journey
      </span>
      <h1
        class="text-4xl sm:text-6xl font-extrabold text-gray-900 dark:text-white tracking-tight"
      >
        Contact & Tour Inquiry
      </h1>
      <p
        class="max-w-2xl mx-auto mt-4 text-gray-600 dark:text-gray-400 text-base sm:text-lg"
      >
        Have questions or want a bespoke itinerary? Send us your travel ideas
        and our Sri Lanka destination specialists will reply within 24 hours.
      </p>
    </div>
  </section>

  <!-- Contact Section -->
  <section
    class="py-20 bg-gray-50 dark:bg-brand-dark transition-colors duration-200"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <!-- Contact Information & Details -->
        <div class="lg:col-span-5 space-y-8 fade-in-element">
          <div>
            <h2
              class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white tracking-tight"
            >
              Get in Touch with Our Team
            </h2>
            <p
              class="text-gray-600 dark:text-gray-400 mt-3 text-sm sm:text-base leading-relaxed"
            >
              Whether you need a dedicated private chauffeur for a week or a
              customized multi-city vacation package, On The Go Ceylon is ready
              to provide seamless solutions on wheels.
            </p>
          </div>

          <!-- Contact Cards -->
          <div class="space-y-4">
            <!-- Phone / WhatsApp -->
            <div
              class="flex items-start gap-4 p-5 rounded-2xl bg-white dark:bg-brand-black border border-gray-200 dark:border-white/10 shadow-sm"
            >
              <div
                class="w-11 h-11 rounded-xl bg-brand-gold/15 text-brand-gold flex items-center justify-center shrink-0"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="text-sm font-semibold text-gray-900 dark:text-white">
                  Call / WhatsApp Hotline
                </h3>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">
                  Instant response for bookings & inquiries
                </p>
                <a
                  href="tel:+94765602424"
                  class="inline-block mt-1 text-sm font-bold text-brand-gold hover:underline"
                >
                  +94 76 560 2424
                </a>
              </div>
            </div>

            <!-- Email -->
            <div
              class="flex items-start gap-4 p-5 rounded-2xl bg-white dark:bg-brand-black border border-gray-200 dark:border-white/10 shadow-sm"
            >
              <div
                class="w-11 h-11 rounded-xl bg-brand-gold/15 text-brand-gold flex items-center justify-center shrink-0"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="text-sm font-semibold text-gray-900 dark:text-white">
                  Email Address
                </h3>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">
                  Send us your itinerary drafts or inquiries
                </p>
                <a
                  href="mailto:onthegoceylonpvtltd@gmail.com"
                  class="inline-block mt-1 text-sm font-bold text-brand-gold hover:underline"
                >
                  onthegoceylonpvtltd@gmail.com
                </a>
              </div>
            </div>

            <!-- Office Location -->
            <div
              class="flex items-start gap-4 p-5 rounded-2xl bg-white dark:bg-brand-black border border-gray-200 dark:border-white/10 shadow-sm"
            >
              <div
                class="w-11 h-11 rounded-xl bg-brand-gold/15 text-brand-gold flex items-center justify-center shrink-0"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  ></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </div>
              <div>
                <h3 class="text-sm font-semibold text-gray-900 dark:text-white">
                  Headquarters
                </h3>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">
                  Bandaranaike & Colombo dispatch hubs
                </p>

                <p class="mt-1 text-sm text-gray-700 dark:text-gray-300">
                  Yakkala, Sri Lanka
                </p>
              </div>
            </div>

            <!-- Operating Hours -->
            <div
              class="flex items-start gap-4 p-5 rounded-2xl bg-white dark:bg-brand-black border border-gray-200 dark:border-white/10 shadow-sm"
            >
              <div
                class="w-11 h-11 rounded-xl bg-brand-gold/15 text-brand-gold flex items-center justify-center shrink-0"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div>
                <h3 class="text-sm font-semibold text-gray-900 dark:text-white">
                  Hours & Chauffeur Dispatch
                </h3>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">
                  24 Hours / 7 Days a Week for Airport & Tour Services
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Clean Form Container -->
        <div class="lg:col-span-7 fade-in-element">
          <div
            class="bg-white dark:bg-brand-black p-8 sm:p-12 rounded-3xl border border-gray-200 dark:border-white/10 shadow-xl dark:shadow-2xl relative"
          >
            <h2
              class="text-2xl sm:text-3xl font-extrabold text-gray-900 dark:text-white mb-2"
            >
              Send Your Inquiry
            </h2>
            <p class="text-sm text-gray-600 dark:text-gray-400 mb-8">
              Fill out the details below and we will prepare a personalized
              itinerary with vehicle options.
            </p>

            <form id="inquiry-form" class="space-y-6">
              <!-- Name Field -->
              <div>
                <label
                  for="name"
                  class="block text-xs font-semibold uppercase tracking-wider text-gray-700 dark:text-gray-300 mb-2"
                >
                  Full Name <span class="text-brand-gold">*</span>
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="e.g. Eleanor Vance"
                  class="w-full px-4 py-3.5 rounded-xl bg-gray-50 dark:bg-brand-dark border border-gray-300 dark:border-white/10 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:border-brand-gold focus:ring-1 focus:ring-brand-gold transition-colors text-sm"
                />
              </div>

              <!-- Email Field -->
              <div>
                <label
                  for="email"
                  class="block text-xs font-semibold uppercase tracking-wider text-gray-700 dark:text-gray-300 mb-2"
                >
                  Email Address <span class="text-brand-gold">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="e.g. eleanor@example.com"
                  class="w-full px-4 py-3.5 rounded-xl bg-gray-50 dark:bg-brand-dark border border-gray-300 dark:border-white/10 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:border-brand-gold focus:ring-1 focus:ring-brand-gold transition-colors text-sm"
                />
              </div>

              <!-- Optional Tour / Destination Selection -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <label
                    for="tour-interest"
                    class="block text-xs font-semibold uppercase tracking-wider text-gray-700 dark:text-gray-300 mb-2"
                  >
                    Tour Package / Interest
                  </label>
                  <select
                    id="tour-interest"
                    name="tour-interest"
                    class="w-full px-4 py-3.5 rounded-xl bg-gray-50 dark:bg-brand-dark border border-gray-300 dark:border-white/10 text-gray-900 dark:text-white focus:outline-none focus:border-brand-gold focus:ring-1 focus:ring-brand-gold transition-colors text-sm"
                  >
                    <option value="General Inquiry">General Inquiry</option>
                    <option value="Cultural Triangle Expedition"
                      >Cultural Triangle Expedition (5D/4N)</option
                    >
                    <option value="Hill Country & Misty Tea Trails"
                      >Hill Country & Misty Tea Trails (6D/5N)</option
                    >
                    <option value="Wildlife Safari & Leopard Expedition"
                      >Wildlife Safari Expedition (4D/3N)</option
                    >
                    <option value="Southern Coastal & Beach Retreat"
                      >Southern Coastal & Beach Retreat (5D/4N)</option
                    >
                    <option value="Custom Itinerary"
                      >Completely Custom Tour</option
                    >
                  </select>
                </div>

                <div>
                  <label
                    for="travelers"
                    class="block text-xs font-semibold uppercase tracking-wider text-gray-700 dark:text-gray-300 mb-2"
                  >
                    Number of Travelers
                  </label>
                  <input
                    type="number"
                    id="travelers"
                    name="travelers"
                    min="1"
                    max="50"
                    placeholder="e.g. 2 adults, 1 child"
                    class="w-full px-4 py-3.5 rounded-xl bg-gray-50 dark:bg-brand-dark border border-gray-300 dark:border-white/10 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:border-brand-gold focus:ring-1 focus:ring-brand-gold transition-colors text-sm"
                  />
                </div>
              </div>

              <!-- Message Field -->
              <div>
                <label
                  for="message"
                  class="block text-xs font-semibold uppercase tracking-wider text-gray-700 dark:text-gray-300 mb-2"
                >
                  Your Message & Travel Preferences <span
                    class="text-brand-gold">*</span
                  >
                </label>
                <textarea
                  id="message"
                  name="message"
                  rows="5"
                  required
                  placeholder="Tell us about your estimated travel dates, preferred destinations (Sigiriya, Ella, Yala, Galle, etc.), vehicle preferences, or any questions."
                  class="w-full px-4 py-3.5 rounded-xl bg-gray-50 dark:bg-brand-dark border border-gray-300 dark:border-white/10 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:border-brand-gold focus:ring-1 focus:ring-brand-gold transition-colors text-sm"
                ></textarea>
              </div>

              <div>
                <button
                  type="submit"
                  class="w-full py-4 px-6 rounded-xl bg-brand-gold text-brand-black font-bold hover:scale-105 transition-transform shadow-lg shadow-brand-gold/20 text-base flex items-center justify-center gap-2.5 cursor-pointer"
                >
                  <!-- WhatsApp Icon -->
                  <svg
                    class="w-5 h-5 shrink-0"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
                    ></path>
                  </svg>
                  <span>Send via WhatsApp</span>
                </button>
              </div>

              <div
                id="form-success"
                class="hidden p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 text-sm text-center"
              >
                🎉 Your inquiry has been sent via WhatsApp! We'll reply as soon
                as possible.
              </div>
              <div
                id="form-error"
                class="hidden p-4 rounded-xl bg-red-500/10 border border-red-500/30 text-red-600 dark:text-red-400 text-sm text-center"
              >
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WhatsApp Inquiry Script -->
  <script is:inline>
    // ── 1. Pre-fill fields from URL query params ──────────────────────────────
    const params = new URLSearchParams(window.location.search);
    const tourParam = params.get("tour");
    const destParam = params.get("destination");
    const selectElem = document.getElementById("tour-interest");
    const messageElem = document.getElementById("message");

    if (tourParam && selectElem) {
      for (let i = 0; i < selectElem.options.length; i++) {
        if (
          selectElem.options[i].value
            .toLowerCase()
            .includes(tourParam.toLowerCase())
        ) {
          selectElem.selectedIndex = i;
          break;
        }
      }
    }

    if (destParam && messageElem && !messageElem.value) {
      messageElem.value = `Hello! I am interested in visiting ${destParam}. Please send me itinerary ideas and private chauffeur vehicle options.`;
    }

    // ── 2. WhatsApp redirect on submit ────────────────────────────────────────
    const WHATSAPP_NUMBER = "94765602424";

    const form = document.getElementById("inquiry-form");
    const successBox = document.getElementById("form-success");
    const errorBox = document.getElementById("form-error");

    if (form) {
      form.addEventListener("submit", (e) => {
        e.preventDefault();

        // Hide any previous messages
        if (successBox) successBox.classList.add("hidden");
        if (errorBox) errorBox.classList.add("hidden");

        // ── 3. Gather field values ──────────────────────────────────────────
        const name = document.getElementById("name")?.value.trim() || "";
        const email = document.getElementById("email")?.value.trim() || "";
        const tour =
          document.getElementById("tour-interest")?.value.trim() ||
          "Not specified";
        const travelers =
          document.getElementById("travelers")?.value.trim() || "Not specified";
        const message = document.getElementById("message")?.value.trim() || "";

        // ── 4. Validate required fields ────────────────────────────────────
        if (!name || !email || !message) {
          if (errorBox) {
            errorBox.textContent =
              "Please fill in all required fields (Name, Email, and Message) before sending.";
            errorBox.classList.remove("hidden");
            errorBox.scrollIntoView({ behavior: "smooth", block: "nearest" });
          }
          return;
        }

        // Basic email format check
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(email)) {
          if (errorBox) {
            errorBox.textContent = "Please enter a valid email address.";
            errorBox.classList.remove("hidden");
            errorBox.scrollIntoView({ behavior: "smooth", block: "nearest" });
          }
          return;
        }

        // ── 5. Format the WhatsApp message ─────────────────────────────────
        const text = [
          "Hello On The Go Ceylon! I would like to make an inquiry.",
          "",
          `Name: ${name}`,
          `Email: ${email}`,
          `Tour Package: ${tour}`,
          `Travelers: ${travelers}`,
          `Message: ${message}`,
        ].join("\n");

        // ── 6. Encode & open WhatsApp ──────────────────────────────────────
        const encodedText = encodeURIComponent(text);
        const waUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodedText}`;
        window.open(waUrl, "_blank", "noopener,noreferrer");

        // ── 7. Show success feedback & reset ──────────────────────────────
        if (successBox) {
          successBox.classList.remove("hidden");
          successBox.scrollIntoView({ behavior: "smooth", block: "nearest" });
        }
        form.reset();
      });
    }
  </script>
</Layout>
