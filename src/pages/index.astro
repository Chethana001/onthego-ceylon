---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

import imgSigiriya from '../assets/sigiriya.jpg';
import imgSigiriyaHero from '../assets/sigiriya-hero.jpg';
import imgElla from '../assets/ella.jpg';
import imgYala from '../assets/yala.jpg';
import imgKandy from '../assets/kandy.jpg';
import imgNuwaraEliya from '../assets/nuwara-eliya.jpg';
import imgGalle from '../assets/galle.jpg';

const featuredDestinations = [
  {
    name: 'Sigiriya Rock Fortress',
    category: 'UNESCO World Heritage',
    tagline: 'The 5th-century palace in the sky with ancient frescoes and lion paws.',
    image: imgSigiriya,
    link: '/destinations#sigiriya',
  },
  {
    name: 'Ella & Nine Arch Bridge',
    category: 'Hill Country Wonder',
    tagline: 'Iconic colonial railway viaduct nestled in lush misty tea hills.',
    image: imgElla,
    link: '/destinations#ella',
  },
  {
    name: 'Yala National Park',
    category: 'Wild Leopard Safari',
    tagline: 'Premier wildlife sanctuary with world-renowned leopard and elephant sightings.',
    image: imgYala,
    link: '/destinations#yala',
  },
  {
    name: 'Kandy & Temple of the Tooth',
    category: 'Cultural Sacred Capital',
    tagline: 'Historic mountain kingdom surrounded by tranquil lake waters and sacred traditions.',
    image: imgKandy,
    link: '/destinations#kandy',
  },
  {
    name: 'Nuwara Eliya',
    category: 'Little England',
    tagline: 'Cool emerald tea plantations, Tudor mansions, and dramatic waterfalls.',
    image: imgNuwaraEliya,
    link: '/destinations#nuwara-eliya',
  },
  {
    name: 'Galle Fort & Lighthouse',
    category: 'Colonial Maritime Heritage',
    tagline: '17th-century ramparts overlooking the rolling waves of the Indian Ocean.',
    image: imgGalle,
    link: '/destinations#galle-fort',
  },
];

const solutionsOnWheels = [
  {
    title: 'Luxury Chauffeured Fleet',
    desc: 'Travel in pristine air-conditioned luxury vans, SUVs, and premium sedans equipped with Wi-Fi and chilled refreshments.',
    icon: 'M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0',
  },
  {
    title: 'Certified Guide-Drivers',
    desc: 'Government-licensed, English-fluent local drivers who share deep historical context, hidden gems, and insider hospitality.',
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  },
  {
    title: 'Bespoke Itineraries',
    desc: 'Every trip is 100% customizable to your schedule, whether you desire heritage trails, wildlife expeditions, or beach relaxations.',
    icon: 'M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7',
  },
  {
    title: '24/7 On-Road Assistance',
    desc: 'Around-the-clock operations team ensuring frictionless transfers, VIP airport pick-ups, and seamless support across the island.',
    icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
  },
];
---

<Layout
  title="On The Go Ceylon | Discover the Pearl of the Indian Ocean"
  description="Experience private luxury travel across Sri Lanka with On The Go Ceylon - Solutions on Wheels. Tailor-made itineraries, certified chauffeur guides, and unforgettable adventures."
>
  <!-- Hero Section (Cinematic Full-Width with Dark Overlay for Maximum Impact in both modes) -->
  <section class="relative min-h-[90vh] flex items-center justify-center -mt-20 overflow-hidden">
    <!-- Full-width Cinematic Image of Sigiriya Rock (local asset) -->
    <Image
      src={imgSigiriyaHero}
      alt="Sigiriya Rock Fortress ancient palace towering over Sri Lanka's emerald forests"
      layout="full-width"
      fit="cover"
      position="center"
      class="absolute inset-0 w-full h-full object-cover object-center"
      loading="eager"
    />

    <!-- bg-black/50 Overlay -->
    <div class="absolute inset-0 bg-black/50 backdrop-contrast-105"></div>

    <!-- Gradient Accents for Visual Depth -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/30"></div>

    <!-- Hero Content -->
    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center py-20">
      <!-- Elegant eyebrow label (no pill box — pure typographic treatment) -->
      <div class="inline-flex items-center justify-center gap-3 sm:gap-4 mb-6 text-brand-gold uppercase tracking-widest text-[11px] sm:text-xs font-semibold">
        <span>On The Go Ceylon</span>
        <span aria-hidden="true" class="block h-3.5 w-px bg-brand-gold/70 shadow-[0_0_8px_rgba(249,168,38,0.9)]"></span>
        <span>Solutions on Wheels</span>
      </div>

      <h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold text-white tracking-tight leading-tight md:leading-none mb-6">
        Discover the Pearl of the <span class="text-brand-gold">Indian Ocean</span>
      </h1>

      <p class="max-w-2xl mx-auto text-lg sm:text-xl text-gray-200 leading-relaxed font-light mb-10">
        Experience Sri Lanka with unmatched elegance. From ancient rock kingdoms and misty tea mountains to wild leopard safaris—crafted with bespoke private chauffeur comfort.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/tours"
          class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-xl bg-brand-gold text-brand-black font-bold hover:scale-105 transition-transform shadow-xl shadow-brand-gold/20 text-base"
        >
          Explore Tour Packages
        </a>
        <a
          href="/contact"
          class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-xl bg-white/10 hover:bg-white/20 text-white font-semibold backdrop-blur-md border border-white/20 transition-all text-base"
        >
          Custom Itinerary Inquiry
        </a>
      </div>

      <!-- Quick Stats -->
      <div class="mt-16 pt-8 border-t border-white/10 grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <div class="text-3xl font-extrabold text-brand-gold">100%</div>
          <div class="text-xs text-gray-300 mt-1 uppercase tracking-wider">Tailor-Made</div>
        </div>
        <div>
          <div class="text-3xl font-extrabold text-white">500+</div>
          <div class="text-xs text-gray-300 mt-1 uppercase tracking-wider">Happy Travelers</div>
        </div>
        <div>
          <div class="text-3xl font-extrabold text-brand-gold">10+</div>
          <div class="text-xs text-gray-300 mt-1 uppercase tracking-wider">Years Experience</div>
        </div>
        <div>
          <div class="text-3xl font-extrabold text-white">24/7</div>
          <div class="text-xs text-gray-300 mt-1 uppercase tracking-wider">On-Road Care</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Destinations (Infinite Marquee) -->
  <section class="py-24 bg-gray-50 dark:bg-brand-dark relative transition-colors duration-200 overflow-hidden">

    <!-- Section Header (constrained width) -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 fade-in-element">
        <span class="text-brand-gold text-xs font-bold tracking-widest uppercase">Iconic Sri Lanka</span>
        <h2 class="text-3xl sm:text-5xl font-extrabold text-gray-900 dark:text-white tracking-tight mt-2">
          Featured Destinations
        </h2>
        <p class="text-gray-600 dark:text-gray-400 mt-4 text-base sm:text-lg">
          Immerse yourself in UNESCO heritage wonders, untamed wildlife parks, and emerald mountain vistas crafted for discerning adventurers.
        </p>
      </div>
    </div>

    <!-- Full-Width Marquee Track -->
    <div class="w-full overflow-hidden">
      <div class="marquee-track flex gap-6 w-max hover:[animation-play-state:paused]">

        <!-- First set of cards -->
        {featuredDestinations.map((dest) => (
          <a
            href={dest.link}
            class="group relative flex-none w-[300px] md:w-[420px] h-[500px] rounded-2xl overflow-hidden shadow-xl border border-white/10 hover:border-brand-gold/60 transition-all duration-300"
          >
            <!-- Background Image -->
            <Image
              src={dest.image}
              alt={dest.name}
              width={840}
              height={1000}
              class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
              loading="lazy"
            />
            <!-- Dark Gradient Overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-black/10 group-hover:from-black/95 transition-all duration-300"></div>
            <!-- Content -->
            <div class="relative z-10 h-full p-6 sm:p-8 flex flex-col justify-end">
              <span class="inline-block text-xs font-semibold uppercase tracking-wider text-brand-gold mb-2">
                {dest.category}
              </span>
              <h3 class="text-xl sm:text-2xl font-bold text-white group-hover:text-brand-gold transition-colors leading-tight">
                {dest.name}
              </h3>
              <p class="text-xs sm:text-sm text-gray-300 mt-2 line-clamp-2 leading-relaxed">
                {dest.tagline}
              </p>
              <div class="mt-4 flex items-center gap-2 text-xs font-bold text-brand-gold">
                <span>Discover highlights</span>
                <svg class="w-4 h-4 transform group-hover:translate-x-1.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </div>
            </div>
          </a>
        ))}

        <!-- Duplicate set for seamless infinite loop -->
        {featuredDestinations.map((dest) => (
          <a
            href={dest.link}
            class="group relative flex-none w-[300px] md:w-[420px] h-[500px] rounded-2xl overflow-hidden shadow-xl border border-white/10 hover:border-brand-gold/60 transition-all duration-300"
            aria-hidden="true"
            tabindex="-1"
          >
            <Image
              src={dest.image}
              alt={dest.name}
              width={840}
              height={1000}
              class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-black/10 group-hover:from-black/95 transition-all duration-300"></div>
            <div class="relative z-10 h-full p-6 sm:p-8 flex flex-col justify-end">
              <span class="inline-block text-xs font-semibold uppercase tracking-wider text-brand-gold mb-2">
                {dest.category}
              </span>
              <h3 class="text-xl sm:text-2xl font-bold text-white group-hover:text-brand-gold transition-colors leading-tight">
                {dest.name}
              </h3>
              <p class="text-xs sm:text-sm text-gray-300 mt-2 line-clamp-2 leading-relaxed">
                {dest.tagline}
              </p>
              <div class="mt-4 flex items-center gap-2 text-xs font-bold text-brand-gold">
                <span>Discover highlights</span>
                <svg class="w-4 h-4 transform group-hover:translate-x-1.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </div>
            </div>
          </a>
        ))}

      </div>
    </div>

    <!-- "View all" link -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-12 text-center fade-in-element">
      <a
        href="/destinations"
        class="inline-flex items-center gap-2 text-brand-gold hover:text-gray-900 dark:hover:text-white font-semibold transition-colors group"
      >
        <span>View all curated Sri Lankan destinations</span>
        <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>

    <!-- Marquee keyframes injected inline -->
    <style>
      @keyframes marquee {
        0%   { transform: translateX(0); }
        100% { transform: translateX(-50%); }
      }
      .marquee-track {
        animation: marquee 38s linear infinite;
      }
      .marquee-track:hover {
        animation-play-state: paused;
      }
    </style>
  </section>


  <!-- Solutions on Wheels Section -->
  <section class="py-20 bg-gray-100 dark:bg-brand-black border-y border-gray-200 dark:border-white/5 transition-colors duration-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 fade-in-element">
        <span class="text-brand-gold text-xs font-bold tracking-widest uppercase">The On The Go Ceylon Advantage</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 dark:text-white mt-2">
          Solutions on Wheels
        </h2>
        <p class="text-gray-600 dark:text-gray-400 mt-4 text-base">
          From the moment you touch down at Bandaranaike International Airport until your departure, we provide effortless private chauffeur mobility.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {solutionsOnWheels.map((item) => (
          <div class="bg-gray-50 dark:bg-brand-dark/60 p-8 rounded-2xl border border-gray-200 dark:border-white/5 hover:border-brand-gold/40 transition-all duration-300 fade-in-element">
            <div class="w-12 h-12 rounded-xl bg-brand-gold/15 border border-brand-gold/30 flex items-center justify-center text-brand-gold mb-6">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">{item.title}</h3>
            <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Banner Section -->
  <section class="py-20 relative overflow-hidden bg-gray-100 dark:bg-brand-dark transition-colors duration-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center fade-in-element">
      <div class="p-10 sm:p-14 rounded-3xl bg-white dark:bg-brand-black border border-gray-200 dark:border-brand-gold/30 shadow-xl dark:shadow-2xl transition-colors duration-200">
        <h2 class="text-3xl sm:text-5xl font-extrabold text-gray-900 dark:text-white tracking-tight mb-4">
          Ready to Craft Your <span class="text-brand-gold">Dream Island Tour</span>?
        </h2>
        <p class="text-gray-600 dark:text-gray-300 max-w-2xl mx-auto mb-8 text-base sm:text-lg leading-relaxed">
          Connect with our Sri Lanka travel planners today. We will design your personalized route, reserve your luxury vehicle, and prepare an unforgettable itinerary.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/contact"
            class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-xl bg-brand-gold text-brand-black font-bold hover:scale-105 transition-transform shadow-lg shadow-brand-gold/25 border border-brand-gold/80"
          >
            Start Your Custom Plan
          </a>
          <a
            href="/tours"
            class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-xl bg-gray-100 dark:bg-white/10 hover:bg-gray-200 dark:hover:bg-white/20 text-gray-800 dark:text-white font-semibold border border-gray-300 dark:border-white/20 transition-all"
          >
            Browse Ready Packages
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
