---
import "../styles/global.css";
import SEO from "../components/SEO.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  canonical?: string;
}

const {
  title = "On The Go Ceylon | Solutions on Wheels - Sri Lanka Private Tours",
  description = "Experience Sri Lanka with On The Go Ceylon - Solutions on Wheels. Tailor-made luxury private tours, chauffeur guides, and unforgettable journeys across the Pearl of the Indian Ocean.",
  image = "https://images.unsplash.com/photo-1586861635167-e5223aadc9fe?auto=format&fit=crop&w=1200&q=80",
  type = "website",
  canonical = Astro.site
    ? new URL(Astro.url.pathname, Astro.site).href
    : Astro.url.href,
} = Astro.props;

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/destinations", label: "Destinations" },
  { href: "/tours", label: "Tours" },
  { href: "/contact", label: "Contact" },
];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#F9A826" />
    <meta name="generator" content={Astro.generator} />

    <!-- Anti-FOUC Theme Script: Prevents flash of wrong theme on page load -->
    <script is:inline>
      const getInitialTheme = () => {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
        ) {
          return localStorage.getItem("theme");
        }
        if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          return "dark";
        }
        return "light";
      };
      if (getInitialTheme() === "dark") {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
    </script>

    <SEO title={title} description={description} image={image} type={type} canonical={canonical} />

    <link rel="icon" type="image/png" href="/flogo.png" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@14.3.0/swiper-bundle.min.css" />
  </head>
  <body
    class="m-0 p-0 min-h-screen flex flex-col bg-slate-50 text-gray-600 dark:bg-[#111111] dark:text-white font-sans antialiased selection:bg-brand-gold selection:text-brand-black transition-colors duration-200"
  >
    <!-- Frosted navigation header shared across all pages -->
    <header
      id="site-header"
      class="fixed top-0 w-full z-50 bg-white/60 dark:bg-[#111]/60 backdrop-blur-md border-b border-gray-200 dark:border-gray-800 text-gray-900 dark:text-white transition-all"
    >
      <div
        class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between"
      >
        <!-- Logo with Dark Mode Visibility Drop Shadow -->
        <a
          href="/"
          class="flex items-center gap-3 transition-opacity hover:opacity-95"
          aria-label="On The Go Ceylon Homepage"
        >
          <img
            src="/logo.png"
            alt="On The Go Ceylon - Solutions on Wheels Logo"
            class="h-16 w-auto object-contain transition-all duration-200 dark:drop-shadow-[0_0_8px_rgba(255,255,255,0.8)]"
          />
        </a>

        <!-- Desktop Navigation -->
        <nav
          class="hidden md:flex items-center gap-7"
          aria-label="Main Navigation"
        >
          {
            navLinks.map((link) => {
              const isActive =
                currentPath === link.href ||
                (link.href !== "/" && currentPath.startsWith(link.href));
              return (
                <a
                  href={link.href}
                  class={`nav-link text-sm font-semibold tracking-wide transition-colors ${
                    isActive
                      ? "nav-link-active text-brand-gold border-b-2 border-brand-gold pb-1"
                      : "text-brand-black dark:text-white hover:text-brand-gold dark:hover:text-brand-gold"
                  }`}
                >
                  {link.label}
                </a>
              );
            })
          }

          <div class="flex items-center gap-3 pl-2">
            <!-- Day/Night Sun/Moon Toggle Button (Desktop) -->
            <button
              id="theme-toggle-desktop"
              type="button"
              class="nav-control p-2.5 rounded-xl border border-gray-200 dark:border-white/10 text-gray-700 dark:text-gray-200 hover:text-brand-gold dark:hover:text-brand-gold bg-gray-100 dark:bg-white/5 hover:bg-gray-200 dark:hover:bg-white/10 transition-colors focus:outline-none focus:ring-2 focus:ring-brand-gold cursor-pointer"
              aria-label="Toggle light and dark mode"
              title="Toggle Day/Night Mode"
            >
              <!-- Sun Icon (shown in dark mode) -->
              <svg
                class="w-5 h-5 hidden dark:block text-brand-gold transition-transform duration-300 hover:rotate-45"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
                ></path>
              </svg>
              <!-- Moon Icon (shown in light mode) -->
              <svg
                class="w-5 h-5 block dark:hidden text-brand-black transition-transform duration-300 hover:-rotate-12"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
                ></path>
              </svg>
            </button>

            <!-- 'Inquire Now' Primary Button -->
            <a
              href="/contact"
              class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg bg-brand-gold text-brand-black font-bold hover:scale-105 transition-transform shadow-md hover:shadow-brand-gold/25 border border-brand-gold/80"
            >
              Inquire Now
            </a>
          </div>
        </nav>

        <!-- Mobile Controls (Theme Toggle + Hamburger) -->
        <div class="flex items-center gap-2 md:hidden">
          <!-- Mobile Theme Toggle -->
          <button
            id="theme-toggle-mobile"
            type="button"
            class="nav-control p-2 rounded-lg border border-gray-200 dark:border-white/10 text-brand-black dark:text-white hover:text-brand-gold hover:bg-gray-100 dark:hover:bg-white/5 focus:outline-none focus:ring-2 focus:ring-brand-gold transition-colors cursor-pointer"
            aria-label="Toggle light and dark mode"
          >
            <!-- Sun Icon -->
            <svg
              class="w-5 h-5 hidden dark:block text-brand-gold"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
              ></path>
            </svg>
            <!-- Moon Icon -->
            <svg
              class="w-5 h-5 block dark:hidden text-brand-black"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
              ></path>
            </svg>
          </button>

          <!-- Mobile Menu Toggle Button -->
          <button
            id="mobile-menu-btn"
            type="button"
            class="nav-control p-2 rounded-lg text-brand-black dark:text-white hover:text-brand-gold hover:bg-gray-100 dark:hover:bg-white/5 focus:outline-none focus:ring-2 focus:ring-brand-gold transition-colors"
            aria-label="Toggle navigation menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <!-- Hamburger Icon -->
            <svg
              id="menu-icon-open"
              class="w-7 h-7 block"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <!-- Close Icon -->
            <svg
              id="menu-icon-close"
              class="w-7 h-7 hidden"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Dropdown Menu -->
      <div
        id="mobile-menu"
        class="md:hidden border-t border-gray-200 dark:border-gray-800 bg-white dark:bg-brand-dark px-4 pt-3 pb-6 space-y-3 transition-all duration-700 ease-in-out shadow-lg opacity-0 -translate-y-12 pointer-events-none invisible max-h-0 overflow-hidden"
      >
        {
          navLinks.map((link) => {
            const isActive =
              currentPath === link.href ||
              (link.href !== "/" && currentPath.startsWith(link.href));
            return (
              <a
                href={link.href}
                class={`block py-2.5 px-3 rounded-md text-base font-semibold dark:text-gray-200 transition-colors ${
                  isActive
                    ? "bg-gray-100 dark:bg-white/5 text-brand-gold"
                    : "text-brand-black hover:bg-gray-50 dark:hover:bg-white/5 hover:text-brand-gold"
                }`}
              >
                {link.label}
              </a>
            );
          })
        }
        <div class="pt-2">
          <a
            href="/contact"
            class="w-full inline-flex items-center justify-center px-5 py-3 rounded-lg bg-brand-gold text-brand-black font-bold hover:scale-105 transition-transform text-center shadow-md border border-brand-gold/80"
          >
            Inquire Now
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer
      class="bg-gray-50 dark:bg-brand-black text-gray-800 dark:text-gray-300 border-t border-gray-200 dark:border-white/10 pt-16 pb-12 transition-colors duration-200"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div
          class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-gray-200 dark:border-white/10"
        >
          <!-- Col 1: Brand -->
          <div class="md:col-span-1 space-y-4">
            <a
              href="/"
              class="inline-block"
              aria-label="On The Go Ceylon Homepage"
            >
              <img
                src="/logo.png"
                alt="On The Go Ceylon - Solutions on Wheels"
                class="h-16 w-auto object-contain dark:drop-shadow-[0_0_8px_rgba(255,255,255,0.8)]"
              />
            </a>
            <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
              Premium travel & private transport solutions across Sri Lanka.
              Tailor-made journeys, certified chauffeur-guides, and curated
              adventures on wheels.
            </p>
          </div>

          <!-- Col 2: Quick Links -->
          <div>
            <h3
              class="text-xs font-bold tracking-wider uppercase text-gray-900 dark:text-white mb-4"
            >
              Quick Links
            </h3>
            <ul class="space-y-2.5 text-sm">
              <li>
                <a
                  href="/"
                  class="text-gray-600 dark:text-gray-400 hover:text-brand-gold dark:hover:text-brand-gold transition-colors"
                  >Home</a
                >
              </li>
              <li>
                <a
                  href="/destinations"
                  class="text-gray-600 dark:text-gray-400 hover:text-brand-gold dark:hover:text-brand-gold transition-colors"
                  >Destinations</a
                >
              </li>
              <li>
                <a
                  href="/tours"
                  class="text-gray-600 dark:text-gray-400 hover:text-brand-gold dark:hover:text-brand-gold transition-colors"
                  >Tour Packages</a
                >
              </li>
              <li>
                <a
                  href="/contact"
                  class="text-gray-600 dark:text-gray-400 hover:text-brand-gold dark:hover:text-brand-gold transition-colors"
                  >Contact & Inquiry</a
                >
              </li>
            </ul>
          </div>

          <!-- Col 3: Popular Tours -->
          <div>
            <h3
              class="text-xs font-bold tracking-wider uppercase text-gray-900 dark:text-white mb-4"
            >
              Featured Tours
            </h3>
            <ul class="space-y-2.5 text-sm">
              <li>
                <a
                  href="/tours#cultural-triangle"
                  class="text-gray-600 dark:text-gray-400 hover:text-brand-gold dark:hover:text-brand-gold transition-colors"
                  >Cultural Triangle</a
                >
              </li>
              <li>
                <a
                  href="/tours#hill-country"
                  class="text-gray-600 dark:text-gray-400 hover:text-brand-gold dark:hover:text-brand-gold transition-colors"
                  >Hill Country Odyssey</a
                >
              </li>
              <li>
                <a
                  href="/tours#wildlife-safari"
                  class="text-gray-600 dark:text-gray-400 hover:text-brand-gold dark:hover:text-brand-gold transition-colors"
                  >Wildlife Safari</a
                >
              </li>
              <li>
                <a
                  href="/tours#beach-retreat"
                  class="text-gray-600 dark:text-gray-400 hover:text-brand-gold dark:hover:text-brand-gold transition-colors"
                  >Tropical Beach Retreat</a
                >
              </li>
            </ul>
          </div>

          <!-- Col 4: Contact & Solutions on Wheels -->
          <div>
            <h3
              class="text-xs font-bold tracking-wider uppercase text-gray-900 dark:text-white mb-4"
            >
              Solutions on Wheels
            </h3>
            <div class="space-y-2.5 text-sm text-gray-600 dark:text-gray-400">
              <p>Private AC Vans, Luxury Sedans & SUVs</p>
              <p>English & Multilingual Speaking Chauffeurs</p>
              <p class="pt-2">
                <span class="text-gray-900 dark:text-white font-semibold"
                  >Head Office:</span
                > Yakkala, Sri Lanka
              </p>
              <p>
                <a
                  href="mailto:onthegoceylonpvtltd@gmail.com"
                  class="text-gray-800 dark:text-brand-gold hover:text-brand-gold font-medium transition-colors"
                  >onthegoceylonpvtltd@gmail.com</a
                >
              </p>
            </div>
          </div>
        </div>

        <!-- Footer Bottom -->
        <div
          class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-gray-500"
        >
          <p>
            &copy; {new Date().getFullYear()} On The Go Ceylon - Solutions on Wheels.
            All rights reserved.
          </p>
          <div class="flex items-center gap-6">
            <a
              href="/contact"
              class="text-gray-600 dark:text-gray-400 hover:text-brand-gold transition-colors"
              >Privacy Policy</a
            >
            <a
              href="/contact"
              class="text-gray-600 dark:text-gray-400 hover:text-brand-gold transition-colors"
              >Terms of Service</a
            >
            <a
              href="/contact"
              class="text-gray-600 dark:text-gray-400 hover:text-brand-gold transition-colors"
              >Support</a
            >
          </div>
        </div>
      </div>
    </footer>

    <!-- Minimal JavaScript: Theme Toggle, Responsive Mobile Menu & Intersection Observer for Scroll Fade -->
    <script is:inline>
      // Theme Toggle Handler
      const toggleTheme = () => {
        const isDark = document.documentElement.classList.toggle("dark");
        if (typeof localStorage !== "undefined") {
          localStorage.setItem("theme", isDark ? "dark" : "light");
        }
      };

      const btnDesktop = document.getElementById("theme-toggle-desktop");
      const btnMobile = document.getElementById("theme-toggle-mobile");

      if (btnDesktop) btnDesktop.addEventListener("click", toggleTheme);
      if (btnMobile) btnMobile.addEventListener("click", toggleTheme);

      // Responsive Hamburger Menu
      const menuBtn = document.getElementById("mobile-menu-btn");
      const mobileMenu = document.getElementById("mobile-menu");
      const iconOpen = document.getElementById("menu-icon-open");
      const iconClose = document.getElementById("menu-icon-close");

      if (menuBtn && mobileMenu && iconOpen && iconClose) {
        const setMobileMenuOpen = (open) => {
          mobileMenu.classList.toggle("opacity-100", open);
          mobileMenu.classList.toggle("translate-y-0", open);
          mobileMenu.classList.toggle("pointer-events-auto", open);
          mobileMenu.classList.toggle("visible", open);
          mobileMenu.classList.toggle("max-h-screen", open);
          mobileMenu.classList.toggle("opacity-0", !open);
          mobileMenu.classList.toggle("-translate-y-12", !open);
          mobileMenu.classList.toggle("pointer-events-none", !open);
          mobileMenu.classList.toggle("invisible", !open);
          mobileMenu.classList.toggle("max-h-0", !open);
          menuBtn.setAttribute("aria-expanded", String(open));
          iconOpen.classList.toggle("hidden", open);
          iconClose.classList.toggle("hidden", !open);
        };

        menuBtn.addEventListener("click", () => {
          const isOpen = mobileMenu.classList.contains("opacity-100");
          setMobileMenuOpen(!isOpen);
        });

        // Close when clicking outside
        document.addEventListener("click", (e) => {
          if (!menuBtn.contains(e.target) && !mobileMenu.contains(e.target)) {
            setMobileMenuOpen(false);
          }
        });

        // Close on Escape key
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && mobileMenu.classList.contains("opacity-100")) {
            setMobileMenuOpen(false);
          }
        });
      }

      // Intersection Observer for Subtle Scroll-Fade Animations
      const observerCallback = (entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      };

      const observer = new IntersectionObserver(observerCallback, {
        threshold: 0.12,
        rootMargin: "0px 0px -40px 0px",
      });

      const targets = document.querySelectorAll(
        ".fade-in-element, [data-reveal]",
      );
      targets.forEach((target) => observer.observe(target));
    </script>

    <!-- Floating WhatsApp Contact Button (all pages) -->
    <a
      href="https://wa.me/94765602424?text=Hello%20On%20The%20Go%20Ceylon,%20I%20would%20like%20to%20inquire%20about%20a%20tour."
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Chat on WhatsApp"
      class="fixed bottom-6 right-6 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-[0_4px_14px_0_rgba(37,211,102,0.39)] hover:scale-110 transition-transform duration-300"
    >
      <!-- Official WhatsApp glyph -->
      <svg class="h-7 w-7 fill-current" viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
        ></path>
      </svg>
    </a>
    <script is:inline src="https://cdn.jsdelivr.net/npm/swiper@14.3.0/swiper-bundle.min.js"></script>
  </body>
</html>



